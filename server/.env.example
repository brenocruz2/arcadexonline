PORT=8080
NODE_ENV=development
# Origens permitidas (CORS/Socket.IO), separadas por vírgula. Vazio = somente mesma origem.
ALLOWED_ORIGIN=http://localhost:8080
# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SOMENTE NO SERVIDOR. Nunca no navegador/Git.
SUPABASE_SERVICE_ROLE_KEY=
# Armazenamento privado (ROMs) e público (capas/logo)
ROM_DIR=./storage/roms
UPLOAD_DIR=./storage/uploads
# Limites (podem ser ajustados também em /admin > Configurações)
MAX_CONNECTIONS=300
